# Copy to .env and adjust. All values are optional.
# Where the Ollama server listens. Ollama defaults to localhost; if you set
# OLLAMA_HOST in the Ollama service, use the same value here.
SWARM_OLLAMA_HOST=http://localhost:11434
# Root directory for the swarm workspace (tasks, artifacts, memory, logs).
# Defaults to ./workspace next to the repo when unset.
# SWARM_WORKSPACE=/path/to/workspace
# Upper operating boundary for swarm memory use, percent of total unified memory.
SWARM_MEMORY_CEILING_PERCENT=70
# Optional search backend. Leave empty for the built-in DuckDuckGo HTML search.
# SWARM_SEARXNG_URL=http://localhost:8080
